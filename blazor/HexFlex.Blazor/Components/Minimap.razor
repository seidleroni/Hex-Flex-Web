@using HexFlex.Blazor.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="minimap" aria-label="Interactive memory map navigator">
    <canvas id="@_canvasId" class="minimap-canvas"></canvas>
</div>

@code {
    [Parameter] public List<MemorySegment> Segments { get; set; } = new();
    [Parameter] public byte[][] SegmentDataArrays { get; set; } = Array.Empty<byte[]>();
    [Parameter] public byte[][] SegmentValidityArrays { get; set; } = Array.Empty<byte[]>();
    [Parameter] public string ScrollContainerId { get; set; } = "";

    private string _canvasId = $"minimap-canvas-{Guid.NewGuid():N}";
    private bool _jsInitialized;
    private byte[][]? _lastDataArrays;

    private const int BytesPerRow = Constants.BytesPerRow;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("hexFlexMinimap.init", _canvasId, ScrollContainerId);
            _jsInitialized = true;

            if (SegmentDataArrays.Length > 0 && SegmentDataArrays != _lastDataArrays)
            {
                _lastDataArrays = SegmentDataArrays;
                await SendDataToJs();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SegmentDataArrays.Length > 0 && SegmentDataArrays != _lastDataArrays && _jsInitialized)
        {
            _lastDataArrays = SegmentDataArrays;
            await SendDataToJs();
        }
    }

    private async Task SendDataToJs()
    {
        var totalSw = System.Diagnostics.Stopwatch.StartNew();
        var sw = System.Diagnostics.Stopwatch.StartNew();
        var layout = BuildLayout();
        Console.WriteLine($"[PERF] Minimap.BuildLayout: {sw.ElapsedMilliseconds}ms");

        sw.Restart();
        var layoutJson = SerializeLayout(layout.entries, layout.totalRowCount);
        Console.WriteLine($"[PERF] Minimap.SerializeLayout: {sw.ElapsedMilliseconds}ms");

        sw.Restart();
        await JS.InvokeVoidAsync("hexFlexMinimap.setData",
            _canvasId, layoutJson, SegmentDataArrays, SegmentValidityArrays);
        Console.WriteLine($"[PERF] Minimap.JS.setData interop: {sw.ElapsedMilliseconds}ms");
        Console.WriteLine($"[PERF] Minimap.SendDataToJs total: {totalSw.ElapsedMilliseconds}ms");
    }

    private const long ViewGapThreshold = Constants.ViewGapThreshold;

    private (List<LayoutEntry> entries, int totalRowCount) BuildLayout()
    {
        if (Segments.Count == 0)
            return (new List<LayoutEntry>(), 0);

        var entries = new List<LayoutEntry>();
        int runningRow = 0;

        for (int segIdx = 0; segIdx < Segments.Count; segIdx++)
        {
            var seg = Segments[segIdx];

            if (segIdx > 0)
            {
                var prev = Segments[segIdx - 1];
                long gapStartAddr = prev.End + 1;
                long gapEndAddr = seg.Start - 1;
                long gapSize = gapEndAddr - gapStartAddr + 1;

                if (gapSize > 0)
                {
                    if (gapSize > ViewGapThreshold)
                    {
                        entries.Add(new LayoutEntry
                        {
                            IsGap = true,
                            GlobalRowStart = runningRow,
                            RowCount = 1,
                            GapStartAddr = gapStartAddr,
                            GapEndAddr = gapEndAddr,
                            SegmentIndex = -1
                        });
                        runningRow += 1;
                    }
                    else
                    {
                        long emptyStart = AlignDown(gapStartAddr);
                        long emptyEnd = AlignDown(gapEndAddr);
                        int emptyRowCount = (int)((emptyEnd - emptyStart) / BytesPerRow) + 1;

                        entries.Add(new LayoutEntry
                        {
                            IsEmpty = true,
                            GlobalRowStart = runningRow,
                            RowCount = emptyRowCount,
                            SegStartAddr = emptyStart,
                            SegmentIndex = -1
                        });
                        runningRow += emptyRowCount;
                    }
                }
            }

            long segAlignedStart = AlignDown(seg.Start);
            long segAlignedEnd = AlignDown(seg.End);
            int rowCount = (int)((segAlignedEnd - segAlignedStart) / BytesPerRow) + 1;

            entries.Add(new LayoutEntry
            {
                GlobalRowStart = runningRow,
                RowCount = rowCount,
                SegStartAddr = segAlignedStart,
                SegmentIndex = segIdx
            });
            runningRow += rowCount;
        }

        return (entries, runningRow);
    }

    private string SerializeLayout(List<LayoutEntry> entries, int totalRowCount)
    {
        var sb = new System.Text.StringBuilder(512);
        sb.Append("{\"totalRowCount\":").Append(totalRowCount).Append(",\"entries\":[");

        for (int i = 0; i < entries.Count; i++)
        {
            if (i > 0) sb.Append(',');
            var le = entries[i];
            sb.Append("{\"isGap\":").Append(le.IsGap ? "true" : "false");
            sb.Append(",\"isEmpty\":").Append(le.IsEmpty ? "true" : "false");
            sb.Append(",\"globalRowStart\":").Append(le.GlobalRowStart);
            sb.Append(",\"rowCount\":").Append(le.RowCount);
            sb.Append(",\"segmentIndex\":").Append(le.SegmentIndex);

            if (le.IsGap)
            {
                sb.Append(",\"gapStartAddr\":").Append(le.GapStartAddr);
                sb.Append(",\"gapEndAddr\":").Append(le.GapEndAddr);
            }
            else
            {
                sb.Append(",\"segStartAddr\":").Append(le.SegStartAddr);
            }
            sb.Append('}');
        }
        sb.Append("]}");
        return sb.ToString();
    }

    private static long AlignDown(long address) => (address / BytesPerRow) * BytesPerRow;

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("hexFlexMinimap.dispose", _canvasId);
        }
        catch (JSDisconnectedException) { }
    }

    private struct LayoutEntry
    {
        public bool IsGap;
        public bool IsEmpty;
        public int GlobalRowStart;
        public int RowCount;
        public long SegStartAddr;
        public int SegmentIndex;
        public long GapStartAddr;
        public long GapEndAddr;
    }
}
