@using HexFlex.Blazor.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="hex-viewer" id="@_elementId">
    <div class="hex-viewer-header-row">
        <span class="hex-hdr-addr">ADDRESS</span>
        <span class="hex-hdr-bytes hex-bytes">@foreach (var i in _byteOffsets)
        {
            <span class="hex-byte hex-byte-hdr">@(i.ToString("X2"))</span>
        }</span>
        <span class="hex-hdr-ascii">ASCII</span>
    </div>
    <div class="hex-viewer-scroll" id="@(_elementId + "-scroll")">
        <div class="hex-viewer-scroll-content">
            @* All row rendering handled by JS — zero C# interop during scrolling *@
        </div>
    </div>
</div>

@code {
    private const int RowHeightPx = Constants.RowHeightPx;
    private const int BytesPerRow = Constants.BytesPerRow;
    private const int BufferRows = Constants.BufferRows;

    private static readonly int[] _byteOffsets = Enumerable.Range(0, BytesPerRow).ToArray();

    [Parameter] public SparseMemory Memory { get; set; } = default!;
    [Parameter] public EventCallback<int> OnActiveSegmentChanged { get; set; }
    [Parameter] public int ActiveSegmentIndex { get; set; }

    private string _elementId = $"hex-viewer-{Guid.NewGuid():N}";
    private string _scrollElementId => _elementId + "-scroll";

    /// <summary>The DOM id of the scroll container, for use by Minimap.</summary>
    public string ScrollContainerId => _scrollElementId;
    private DotNetObjectReference<HexViewer>? _dotNetRef;
    private bool _jsInitialized;
    private SparseMemory? _lastMemory;

    // Layout data (kept in C# for GoToAddress calculations)
    private LayoutEntry[] _layout = Array.Empty<LayoutEntry>();
    private int _totalRowCount;
    private List<MemorySegment> _segments = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("hexFlexHexViewer.init", _scrollElementId, _dotNetRef);
            _jsInitialized = true;

            if (Memory != null && Memory != _lastMemory)
            {
                _lastMemory = Memory;
                await SendDataToJs();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Memory != null && Memory != _lastMemory && _jsInitialized)
        {
            _lastMemory = Memory;
            await SendDataToJs();
        }
    }

    private async Task SendDataToJs()
    {
        _segments = Memory.GetDataSegments();
        BuildLayout();

        // Serialize layout as JSON
        var layoutJson = SerializeLayout();

        // Extract byte data per segment as arrays
        var segmentDataArrays = new byte[_segments.Count][];
        var segmentValidityArrays = new byte[_segments.Count][];

        for (int segIdx = 0; segIdx < _segments.Count; segIdx++)
        {
            var seg = _segments[segIdx];
            long alignedStart = AlignDown(seg.Start);
            long alignedEnd = AlignDown(seg.End);
            int rowCount = (int)((alignedEnd - alignedStart) / BytesPerRow) + 1;
            int byteCount = rowCount * BytesPerRow;

            var data = new byte[byteCount];
            var validity = new byte[byteCount];

            for (int i = 0; i < byteCount; i++)
            {
                long addr = alignedStart + i;
                var b = Memory.GetByte(addr);
                if (b.HasValue)
                {
                    data[i] = b.Value;
                    validity[i] = 1;
                }
            }

            segmentDataArrays[segIdx] = data;
            segmentValidityArrays[segIdx] = validity;
        }

        await JS.InvokeVoidAsync("hexFlexHexViewer.setData",
            _scrollElementId, layoutJson, segmentDataArrays, segmentValidityArrays);
    }

    private string SerializeLayout()
    {
        var sb = new System.Text.StringBuilder(512);
        sb.Append("{\"totalRowCount\":").Append(_totalRowCount).Append(",\"entries\":[");

        for (int i = 0; i < _layout.Length; i++)
        {
            if (i > 0) sb.Append(',');
            var le = _layout[i];
            sb.Append("{\"isGap\":").Append(le.IsGap ? "true" : "false");
            sb.Append(",\"isEmpty\":").Append(le.IsEmpty ? "true" : "false");
            sb.Append(",\"globalRowStart\":").Append(le.GlobalRowStart);
            sb.Append(",\"rowCount\":").Append(le.RowCount);
            sb.Append(",\"segmentIndex\":").Append(le.SegmentIndex);

            if (le.IsGap)
            {
                sb.Append(",\"gapStartAddr\":").Append(le.GapStartAddr);
                sb.Append(",\"gapEndAddr\":").Append(le.GapEndAddr);
            }
            else
            {
                sb.Append(",\"segStartAddr\":").Append(le.SegStartAddr);
            }
            sb.Append('}');
        }
        sb.Append("]}");
        return sb.ToString();
    }

    private const long ViewGapThreshold = Constants.ViewGapThreshold;

    private void BuildLayout()
    {
        if (_segments.Count == 0)
        {
            _layout = Array.Empty<LayoutEntry>();
            _totalRowCount = 0;
            return;
        }

        var entries = new List<LayoutEntry>();
        int runningRow = 0;

        for (int segIdx = 0; segIdx < _segments.Count; segIdx++)
        {
            var seg = _segments[segIdx];

            if (segIdx > 0)
            {
                var prev = _segments[segIdx - 1];
                long gapStartAddr = prev.End + 1;
                long gapEndAddr = seg.Start - 1;
                long gapSize = gapEndAddr - gapStartAddr + 1;

                if (gapSize > 0)
                {
                    if (gapSize > ViewGapThreshold)
                    {
                        // Large gap: collapse to a single row
                        entries.Add(new LayoutEntry
                        {
                            IsGap = true,
                            GlobalRowStart = runningRow,
                            RowCount = 1,
                            GapStartAddr = gapStartAddr,
                            GapEndAddr = gapEndAddr,
                            SegmentIndex = -1
                        });
                        runningRow += 1;
                    }
                    else
                    {
                        // Small gap: expand into individual empty rows
                        long emptyStart = AlignDown(gapStartAddr);
                        long emptyEnd = AlignDown(gapEndAddr);
                        int emptyRowCount = (int)((emptyEnd - emptyStart) / BytesPerRow) + 1;

                        entries.Add(new LayoutEntry
                        {
                            IsGap = false,
                            IsEmpty = true,
                            GlobalRowStart = runningRow,
                            RowCount = emptyRowCount,
                            SegStartAddr = emptyStart,
                            SegmentIndex = -1
                        });
                        runningRow += emptyRowCount;
                    }
                }
            }

            long segAlignedStart = AlignDown(seg.Start);
            long segAlignedEnd = AlignDown(seg.End);
            int rowCount = (int)((segAlignedEnd - segAlignedStart) / BytesPerRow) + 1;

            entries.Add(new LayoutEntry
            {
                IsGap = false,
                GlobalRowStart = runningRow,
                RowCount = rowCount,
                SegStartAddr = segAlignedStart,
                SegmentIndex = segIdx
            });
            runningRow += rowCount;
        }

        _layout = entries.ToArray();
        _totalRowCount = runningRow;
    }

    [JSInvokable]
    public void OnActiveSegmentChangedFromJs(int segmentIndex)
    {
        if (segmentIndex != ActiveSegmentIndex)
        {
            OnActiveSegmentChanged.InvokeAsync(segmentIndex);
        }
    }

    public async Task GoToAddress(long address)
    {
        // All logic (layout lookup, scroll, highlight) runs in JS — no interop delay
        await JS.InvokeVoidAsync("hexFlexHexViewer.goToAddress", _scrollElementId, (double)address);
    }

    private static long AlignDown(long address) => (address / BytesPerRow) * BytesPerRow;

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("hexFlexHexViewer.dispose", _scrollElementId);
        }
        catch (JSDisconnectedException) { }
        _dotNetRef?.Dispose();
    }

    private struct LayoutEntry
    {
        public bool IsGap;
        public bool IsEmpty;
        public int GlobalRowStart;
        public int RowCount;
        public long SegStartAddr;
        public int SegmentIndex;
        public long GapStartAddr;
        public long GapEndAddr;
    }
}
