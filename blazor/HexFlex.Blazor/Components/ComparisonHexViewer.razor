@using HexFlex.Blazor.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="hex-viewer" id="@_elementId">
    <div class="hex-viewer-header-row">
        <span class="hex-hdr-addr">ADDRESS</span>
        <span class="hex-hdr-bytes hex-bytes">@foreach (var i in _byteOffsets)
        {
            <span class="hex-byte hex-byte-hdr">@(i.ToString("X2"))</span>
        }</span>
        <span class="hex-hdr-ascii">ASCII</span>
    </div>
    <div class="hex-viewer-scroll" id="@(_elementId + "-scroll")">
        <div class="hex-viewer-scroll-content">
            @* All row rendering handled by JS *@
        </div>
    </div>
</div>

@code {
    private const int BytesPerRow = Constants.BytesPerRow;

    private static readonly int[] _byteOffsets = Enumerable.Range(0, BytesPerRow).ToArray();

    [Parameter] public ComparisonResult Comparison { get; set; } = default!;
    [Parameter] public EventCallback<int> OnActiveSegmentChanged { get; set; }
    [Parameter] public int ActiveSegmentIndex { get; set; }

    private string _elementId = $"cmp-hex-viewer-{Guid.NewGuid():N}";
    private string _scrollElementId => _elementId + "-scroll";

    public string ScrollContainerId => _scrollElementId;
    private DotNetObjectReference<ComparisonHexViewer>? _dotNetRef;
    private bool _jsInitialized;
    private ComparisonResult? _lastComparison;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("hexFlexComparisonHexViewer.init", _scrollElementId, _dotNetRef);
            _jsInitialized = true;

            if (Comparison != null && Comparison != _lastComparison)
            {
                _lastComparison = Comparison;
                await SendDataToJs();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Comparison != null && Comparison != _lastComparison && _jsInitialized)
        {
            _lastComparison = Comparison;
            await SendDataToJs();
        }
    }

    private async Task SendDataToJs()
    {
        var virtualRows = Comparison.GetVirtualRows();
        if (virtualRows.Count == 0) return;

        // Count data rows for array sizing
        int dataRowCount = 0;
        foreach (var vr in virtualRows)
        {
            if (!vr.IsGap) dataRowCount++;
        }

        // Build flat arrays: 16 bytes per data row
        int totalBytes = dataRowCount * BytesPerRow;
        var diffTypes = new byte[totalBytes];
        var bytesB = new byte[totalBytes];
        var bytesA = new byte[totalBytes];
        var validity = new byte[totalBytes];

        int dataIdx = 0;
        foreach (var vr in virtualRows)
        {
            if (vr.IsGap) continue;

            int baseOffset = dataIdx * BytesPerRow;
            for (int j = 0; j < BytesPerRow; j++)
            {
                long addr = vr.Address + j;
                var entry = Comparison.GetDiffEntry(addr);

                diffTypes[baseOffset + j] = (byte)entry.Type;
                bytesA[baseOffset + j] = entry.ByteA ?? 0;
                bytesB[baseOffset + j] = entry.ByteB ?? (entry.ByteA ?? 0);
                validity[baseOffset + j] = (byte)((entry.ByteA is not null || entry.ByteB is not null) ? 1 : 0);
            }
            dataIdx++;
        }

        // Serialize virtual rows as JSON
        var vrJson = SerializeVirtualRows(virtualRows);

        await JS.InvokeVoidAsync("hexFlexComparisonHexViewer.setData",
            _scrollElementId, vrJson, diffTypes, bytesB, bytesA, validity);
    }

    private static string SerializeVirtualRows(List<ComparisonVirtualRow> rows)
    {
        var sb = new System.Text.StringBuilder(256);
        sb.Append('[');
        for (int i = 0; i < rows.Count; i++)
        {
            if (i > 0) sb.Append(',');
            var vr = rows[i];
            sb.Append("{\"isGap\":").Append(vr.IsGap ? "true" : "false");
            sb.Append(",\"segmentIndex\":").Append(vr.SegmentIndex);
            if (vr.IsGap)
            {
                sb.Append(",\"gapStartAddr\":").Append(vr.GapStartAddr);
                sb.Append(",\"gapEndAddr\":").Append(vr.GapEndAddr);
                sb.Append(",\"skippedBytes\":").Append(vr.SkippedBytes);
            }
            else
            {
                sb.Append(",\"address\":").Append(vr.Address);
            }
            sb.Append('}');
        }
        sb.Append(']');
        return sb.ToString();
    }

    [JSInvokable]
    public void OnActiveSegmentChangedFromJs(int segmentIndex)
    {
        if (segmentIndex != ActiveSegmentIndex)
        {
            OnActiveSegmentChanged.InvokeAsync(segmentIndex);
        }
    }

    public async Task GoToAddress(long address)
    {
        await JS.InvokeVoidAsync("hexFlexComparisonHexViewer.goToAddress", _scrollElementId, (double)address);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("hexFlexComparisonHexViewer.dispose", _scrollElementId);
        }
        catch (JSDisconnectedException) { }
        _dotNetRef?.Dispose();
    }
}
