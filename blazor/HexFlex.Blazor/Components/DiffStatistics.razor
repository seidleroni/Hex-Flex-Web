@using HexFlex.Blazor.Services

<div class="diff-statistics-grid">
    <div class="diff-stat-card">
        <p class="diff-stat-label">Bytes Modified</p>
        <p class="diff-stat-value diff-stat-value-modified">@Stats.Modified</p>
    </div>
    <div class="diff-stat-card">
        <p class="diff-stat-label">Bytes Added</p>
        <p class="diff-stat-value diff-stat-value-added">@Stats.Added</p>
    </div>
    <div class="diff-stat-card">
        <p class="diff-stat-label">Bytes Removed</p>
        <p class="diff-stat-value diff-stat-value-removed">@Stats.Removed</p>
    </div>
</div>

@code {
    [Parameter] public DiffStats Stats { get; set; } = new(0, 0, 0);
}
