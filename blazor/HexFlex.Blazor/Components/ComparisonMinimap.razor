@using HexFlex.Blazor.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="minimap" aria-label="Interactive comparison minimap">
    <canvas id="@_canvasId" class="minimap-canvas"></canvas>
</div>

@code {
    [Parameter] public ComparisonResult Comparison { get; set; } = default!;
    [Parameter] public byte[] DiffTypes { get; set; } = Array.Empty<byte>();
    [Parameter] public byte[] BytesA { get; set; } = Array.Empty<byte>();
    [Parameter] public byte[] Validity { get; set; } = Array.Empty<byte>();
    [Parameter] public string VirtualRowsJson { get; set; } = "[]";
    [Parameter] public string ScrollContainerId { get; set; } = "";

    private string _canvasId = $"cmp-minimap-{Guid.NewGuid():N}";
    private bool _jsInitialized;
    private byte[]? _lastDiffTypes;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("hexFlexComparisonMinimap.init", _canvasId, ScrollContainerId);
            _jsInitialized = true;

            if (HasValidData() && DiffTypes != _lastDiffTypes)
            {
                _lastDiffTypes = DiffTypes;
                await SendDataToJs();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (HasValidData() && DiffTypes != _lastDiffTypes && _jsInitialized)
        {
            _lastDiffTypes = DiffTypes;
            await SendDataToJs();
        }
    }

    private bool HasValidData() => DiffTypes.Length > 0 && VirtualRowsJson.Length > 2;

    private async Task SendDataToJs()
    {
        var sw = System.Diagnostics.Stopwatch.StartNew();
        await JS.InvokeVoidAsync("hexFlexComparisonMinimap.setData",
            _canvasId, VirtualRowsJson, DiffTypes, BytesA, Validity);
        Console.WriteLine($"[PERF] CompMinimap.JS.setData interop: {sw.ElapsedMilliseconds}ms");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("hexFlexComparisonMinimap.dispose", _canvasId);
        }
        catch (JSDisconnectedException) { }
    }
}
