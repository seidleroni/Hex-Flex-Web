<div class="minimap-legend" aria-label="Minimap Legend">
    <div class="minimap-legend-item">
        <span class="minimap-legend-swatch" style="background-color: #22d3ee;"></span> Data
    </div>
    <div class="minimap-legend-item">
        <span class="minimap-legend-swatch" style="background-color: #94a3b8;"></span> Erased (0xFF)
    </div>
    <div class="minimap-legend-item">
        <span class="minimap-legend-swatch" style="background-color: #374151;"></span> Empty
    </div>
    <div class="minimap-legend-item">
        <span class="minimap-legend-swatch" style="background-color: #8b5cf6;"></span> Gap
    </div>
</div>
