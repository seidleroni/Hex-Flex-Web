@page "/compare"
@using HexFlex.Blazor.Services
@using HexFlex.Blazor.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Hex Flex - Compare</PageTitle>

@if (_comparison is null)
{
    <div class="upload-section" style="max-width:64rem;">
        <div style="margin-bottom:2rem;">
            <h2 class="upload-heading">Compare Intel HEX Files</h2>
            <p class="upload-subheading">Upload two Intel HEX files to compare their memory content.</p>
        </div>

        <div class="compare-upload-grid">
            @* File A *@
            <div class="compare-upload-slot">
                <h3>File A (Original)</h3>
                @if (MemoryA is not null)
                {
                    <FileInfoCard FileName="@FileNameA"
                                  StartAddress="_startAddressA"
                                  DataSize="_dataSizeA"
                                  SegmentCount="_segmentCountA"
                                  OnLoadNew="ResetA" />
                }
                else
                {
                    <FileUpload OnFileSelected="HandleFileASelected" />
                    @if (ErrorA is not null)
                    {
                        <div class="error-alert" role="alert">
                            <strong>Error: </strong><span>@ErrorA</span>
                        </div>
                    }
                }
            </div>

            @* File B *@
            <div class="compare-upload-slot">
                <h3>File B (Modified)</h3>
                @if (MemoryB is not null)
                {
                    <FileInfoCard FileName="@FileNameB"
                                  StartAddress="_startAddressB"
                                  DataSize="_dataSizeB"
                                  SegmentCount="_segmentCountB"
                                  OnLoadNew="ResetB" />
                }
                else
                {
                    <FileUpload OnFileSelected="HandleFileBSelected" />
                    @if (ErrorB is not null)
                    {
                        <div class="error-alert" role="alert">
                            <strong>Error: </strong><span>@ErrorB</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="comparison-view">
        @* Compact file info + upload slots *@
        <div class="compare-upload-grid" style="margin-bottom:0.5rem;">
            <div class="compare-upload-slot">
                <h3>File A (Original)</h3>
                <FileInfoCard FileName="@FileNameA"
                              StartAddress="_startAddressA"
                              DataSize="_dataSizeA"
                              SegmentCount="_segmentCountA"
                              OnLoadNew="ResetA" />
            </div>
            <div class="compare-upload-slot">
                <h3>File B (Modified)</h3>
                <FileInfoCard FileName="@FileNameB"
                              StartAddress="_startAddressB"
                              DataSize="_dataSizeB"
                              SegmentCount="_segmentCountB"
                              OnLoadNew="ResetB" />
            </div>
        </div>

        <DiffStatistics Stats="_comparison.Stats" />
        <DiffLegend />

        <div class="comparison-content">
            @if (_segments.Count > 1)
            {
                <SegmentPanel Segments="_compSegmentsMapped"
                              ActiveSegmentIndex="_activeSegmentIndex"
                              OnSegmentClick="HandleSegmentClick" />
            }
            <ComparisonHexViewer @ref="_compHexViewer"
                                 Comparison="_comparison"
                                 DiffTypes="_diffTypes"
                                 BytesA="_bytesA"
                                 BytesB="_bytesB"
                                 Validity="_validity"
                                 VirtualRowsJson="@_virtualRowsJson"
                                 ActiveSegmentIndex="_activeSegmentIndex"
                                 OnActiveSegmentChanged="HandleActiveSegmentChanged" />
            @if (_compHexViewer != null)
            {
                <ComparisonMinimap Comparison="_comparison"
                                   DiffTypes="_diffTypes"
                                   BytesA="_bytesA"
                                   Validity="_validity"
                                   VirtualRowsJson="@_virtualRowsJson"
                                   ScrollContainerId="@_compHexViewer.ScrollContainerId" />
            }
            @if (_diffAddresses.Count > 0)
            {
                <DiffNavigator OnPrev="HandlePrevDiff"
                               OnNext="HandleNextDiff"
                               IsPrevDisabled="_isPrevDisabled"
                               IsNextDisabled="_isNextDisabled" />
            }
        </div>
    </div>
}

@code {
    private SparseMemory? MemoryA { get; set; }
    private SparseMemory? MemoryB { get; set; }
    private string FileNameA { get; set; } = "";
    private string FileNameB { get; set; } = "";
    private string? ErrorA { get; set; }
    private string? ErrorB { get; set; }

    // Cached stats
    private long _startAddressA, _dataSizeA;
    private int _segmentCountA;
    private long _startAddressB, _dataSizeB;
    private int _segmentCountB;

    // Comparison state
    private ComparisonResult? _comparison;
    private List<ComparisonSegment> _segments = new();
    private List<MemorySegment> _compSegmentsMapped = new();
    private List<long> _diffAddresses = new();
    private int _activeSegmentIndex;
    private int _highlightedDiffIndex = -1;
    private ComparisonHexViewer? _compHexViewer;
    private bool _needsMinimapRender;

    // Pre-extracted diff data (shared between CompHexViewer and CompMinimap)
    private byte[] _diffTypes = Array.Empty<byte>();
    private byte[] _bytesA = Array.Empty<byte>();
    private byte[] _bytesB = Array.Empty<byte>();
    private byte[] _validity = Array.Empty<byte>();
    private string _virtualRowsJson = "[]";

    private bool _isPrevDisabled => _highlightedDiffIndex == 0;
    private bool _isNextDisabled => _highlightedDiffIndex != -1 && _highlightedDiffIndex == _diffAddresses.Count - 1;

    protected override void OnAfterRender(bool firstRender)
    {
        if (_needsMinimapRender && _compHexViewer != null)
        {
            _needsMinimapRender = false;
            StateHasChanged();
        }
    }

    private async Task HandleFileASelected(IBrowserFile file)
    {
        var (memory, error) = await ParseFile(file);
        if (error is not null)
        {
            ErrorA = error;
            return;
        }
        MemoryA = memory;
        FileNameA = file.Name;
        ErrorA = null;
        _startAddressA = memory!.GetStartAddress();
        _dataSizeA = memory.GetDataSize();
        _segmentCountA = memory.GetDataSegments().Count;
        TryCompare();
    }

    private async Task HandleFileBSelected(IBrowserFile file)
    {
        var (memory, error) = await ParseFile(file);
        if (error is not null)
        {
            ErrorB = error;
            return;
        }
        MemoryB = memory;
        FileNameB = file.Name;
        ErrorB = null;
        _startAddressB = memory!.GetStartAddress();
        _dataSizeB = memory.GetDataSize();
        _segmentCountB = memory.GetDataSegments().Count;
        TryCompare();
    }

    private void TryCompare()
    {
        if (MemoryA is not null && MemoryB is not null)
        {
            var totalSw = System.Diagnostics.Stopwatch.StartNew();
            var sw = System.Diagnostics.Stopwatch.StartNew();
            _comparison = MemoryComparer.Compare(MemoryA, MemoryB);
            Console.WriteLine($"[PERF] Compare.MemoryComparer.Compare: {sw.ElapsedMilliseconds}ms");

            sw.Restart();
            _segments = _comparison.GetDataSegments();
            _diffAddresses = _comparison.GetDiffAddresses();
            Console.WriteLine($"[PERF] Compare.GetSegments+DiffAddrs: {sw.ElapsedMilliseconds}ms ({_segments.Count} segments, {_diffAddresses.Count} diffs)");

            sw.Restart();
            _comparison.ExtractDiffArrays(out var dt, out var ba, out var bb, out var v, out _);
            _diffTypes = dt;
            _bytesA = ba;
            _bytesB = bb;
            _validity = v;
            Console.WriteLine($"[PERF] Compare.ExtractDiffArrays: {sw.ElapsedMilliseconds}ms ({_diffTypes.Length} bytes)");

            sw.Restart();
            _virtualRowsJson = SerializeVirtualRows(_comparison.GetVirtualRows());
            Console.WriteLine($"[PERF] Compare.SerializeVirtualRows: {sw.ElapsedMilliseconds}ms ({_virtualRowsJson.Length} chars)");

            _highlightedDiffIndex = -1;
            _activeSegmentIndex = 0;
            _needsMinimapRender = true;

            // Map ComparisonSegment to MemorySegment for SegmentPanel compatibility
            _compSegmentsMapped = _segments.Select(s => new MemorySegment(s.Start, s.End)).ToList();
            Console.WriteLine($"[PERF] Compare.TryCompare total: {totalSw.ElapsedMilliseconds}ms");
        }
    }

    private static string SerializeVirtualRows(List<ComparisonVirtualRow> rows)
    {
        var sb = new System.Text.StringBuilder(rows.Count * 40);
        sb.Append('[');
        for (int i = 0; i < rows.Count; i++)
        {
            if (i > 0) sb.Append(',');
            var vr = rows[i];
            sb.Append("{\"isGap\":").Append(vr.IsGap ? "true" : "false");
            sb.Append(",\"segmentIndex\":").Append(vr.SegmentIndex);
            if (vr.IsGap)
            {
                sb.Append(",\"gapStartAddr\":").Append(vr.GapStartAddr);
                sb.Append(",\"gapEndAddr\":").Append(vr.GapEndAddr);
                sb.Append(",\"skippedBytes\":").Append(vr.SkippedBytes);
            }
            else
            {
                sb.Append(",\"address\":").Append(vr.Address);
            }
            sb.Append('}');
        }
        sb.Append(']');
        return sb.ToString();
    }

    private static async Task<(SparseMemory? memory, string? error)> ParseFile(IBrowserFile file)
    {
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: Constants.MaxFileSize);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            var content = System.Text.Encoding.UTF8.GetString(ms.ToArray());

            if (!FileValidator.IsIntelHexContent(content))
                return (null, "The file does not appear to be a valid Intel HEX file.");

            return (HexParser.Parse(content), null);
        }
        catch (Exception ex)
        {
            return (null, $"Failed to parse file: {ex.Message}");
        }
    }

    private void ResetA()
    {
        MemoryA = null;
        FileNameA = "";
        ErrorA = null;
        _comparison = null;
        _compHexViewer = null;
    }

    private void ResetB()
    {
        MemoryB = null;
        FileNameB = "";
        ErrorB = null;
        _comparison = null;
        _compHexViewer = null;
    }

    private async Task HandleSegmentClick(long address)
    {
        for (int i = 0; i < _segments.Count; i++)
        {
            if (_segments[i].Start == address)
            {
                _activeSegmentIndex = i;
                break;
            }
        }

        _highlightedDiffIndex = -1; // Clear diff highlight on segment navigation

        if (_compHexViewer != null)
        {
            await _compHexViewer.GoToAddress(address);
        }
    }

    private void HandleActiveSegmentChanged(int segmentIndex)
    {
        if (segmentIndex != _activeSegmentIndex)
        {
            _activeSegmentIndex = segmentIndex;
            StateHasChanged();
        }
    }

    private async Task HandleNextDiff()
    {
        if (_diffAddresses.Count == 0) return;

        var nextIndex = _highlightedDiffIndex + 1;
        if (nextIndex < _diffAddresses.Count)
        {
            _highlightedDiffIndex = nextIndex;
            var addr = _diffAddresses[nextIndex];
            if (_compHexViewer != null)
            {
                await _compHexViewer.GoToAddress(addr);
            }
        }
    }

    private async Task HandlePrevDiff()
    {
        if (_diffAddresses.Count == 0) return;

        var prevIndex = _highlightedDiffIndex == -1 ? _diffAddresses.Count - 1 : _highlightedDiffIndex - 1;
        if (prevIndex >= 0)
        {
            _highlightedDiffIndex = prevIndex;
            var addr = _diffAddresses[prevIndex];
            if (_compHexViewer != null)
            {
                await _compHexViewer.GoToAddress(addr);
            }
        }
    }
}
