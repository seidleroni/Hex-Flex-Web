@inherits LayoutComponentBase

<div class="app-shell">
    <Header ViewMode="@ViewMode" OnViewModeChanged="@SetViewMode" />
    <main class="app-main">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <div class="error-boundary-content" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="error-boundary-icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                    <h2 class="error-boundary-title">Something went wrong</h2>
                    <p class="error-boundary-message">An unexpected error occurred. You can try recovering or reload the page.</p>
                    <button class="error-boundary-btn" @onclick="RecoverFromError">
                        Try Again
                    </button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
    <Footer />
</div>

@code {
    private string ViewMode { get; set; } = "view";
    private ErrorBoundary? _errorBoundary;

    [CascadingParameter]
    private string? RouteViewMode { get; set; }

    private void SetViewMode(string mode)
    {
        ViewMode = mode;
        NavigationManager.NavigateTo(mode == "compare" ? "/compare" : "/");
    }

    protected override void OnParametersSet()
    {
        // Sync view mode from route
        var uri = NavigationManager.Uri;
        if (uri.Contains("/compare", StringComparison.OrdinalIgnoreCase))
            ViewMode = "compare";
        else
            ViewMode = "view";
    }

    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}
